<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>human_detection_fusion</name>
  <version>0.0.0</version>
  <description>ROS 2 node for YOLO and UWB sensor fusion. It processes detections from the ultralytics_ros wrapper and performs spatial association to generate the TrackedAgents messages required by the CoHAN Social Planner.</description>
  <maintainer email="nikolas.lappas.2003@gmail.com">root</maintainer>
  <license>AGPL-3.0-only</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>vision_msgs</depend>
  <depend>cohan_msgs</depend>
  <depend>ultralytics_ros</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>std_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
